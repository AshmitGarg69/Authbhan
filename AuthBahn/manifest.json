{
  "manifest_version": 3,
  "name": "CRISPR AuthBahn",
  "description": "CRISPR-IIITN official extension for Fortinet Login & Smart Tunnel Routing.",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab",
    "webNavigation",
    "proxy"
  ],
  "host_permissions": [
    "*://192.168.55.253/*",
    "http://127.0.0.1:8080/*",
    "http://192.168.77.84/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crispr-authbahn@iiitn.ac.in"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://192.168.55.253/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
